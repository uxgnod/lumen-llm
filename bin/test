#!/usr/bin/env ruby

ENV["RACK_ENV"] ||= "test"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
$LOAD_PATH.unshift(File.expand_path("../test", __dir__))

files = ARGV.empty? ? Dir[File.expand_path("../test/**/*_test.rb", __dir__)] : ARGV
files.sort.each { |file| require File.expand_path(file) }
